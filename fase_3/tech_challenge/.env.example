# Copie este arquivo para ".env" e preencha os valores antes de rodar o projeto.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).

# Usada pela camada de orquestração (LangChain/LangGraph) para chamadas de LLM
# via API (chains, agents, e como fallback quando o modelo fine-tuned local
# não estiver disponível). Sem essa chave, o projeto roda no modo 100% local
# (ver USE_LOCAL_ONLY abaixo).
OPENAI_API_KEY=

# Se "true", o projeto nunca chama a API da OpenAI: usa o modelo local
# (demo CPU ou modelo fine-tuned via Unsloth, se presente em models/) em
# todos os nós do grafo, inclusive nos que normalmente usariam a API.
USE_LOCAL_ONLY=false

# Caminho do modelo de domínio a ser carregado pelo DomainLLM
# (src/models/domain_llm.py). Pode apontar para:
#   - um adaptador LoRA "de verdade" (gerado por notebooks/fine_tuning_colab.ipynb
#     no Google Colab, com GPU) - carregado via transformers + peft; ou
#   - o índice de recuperação leve gerado por src/fine_tuning/train_demo_cpu.py,
#     usado como stand-in sem GPU/internet para validar o pipeline.
# Se vazio ou inexistente, cai automaticamente para o modelo de demonstração.
FINE_TUNED_MODEL_PATH=models/demo_retrieval

# Modelo da OpenAI usado na orquestração (chains/agents), quando aplicável.
OPENAI_ORCHESTRATION_MODEL=gpt-4o-mini
